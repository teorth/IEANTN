 /-- **`Re ψ(σ + it) ≤ log σ + ½ log(1 + t²/(σ−1)²)`** for `σ > 1`. -/
+
 theorem re_digamma_le {σ t : ℝ} (hσ : 1 < σ) :
     (Complex.digamma ((σ : ℂ) + t * I)).re ≤ Real.log σ + 1 / 2 * Real.log (1 + t ^ 2 / (σ - 1) ^ 2) := by
   have hs : 1 / 2 < ((σ : ℂ) + t * I).re := by simp; linarith
